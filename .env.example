# Copie para .env e troque todos os valores. O .env nunca vai para o Git.
# Gerar valores: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=troque-esta-senha
DEVICE_TOKEN=troque-token-do-carrinho
INTEGRACAO_TOKEN=troque-chave-da-integracao
METRICS_TOKEN=troque-token-das-metricas
MINUTOS_SEM_LEITURA_ALERTA=10
GRANJA_LATITUDE=-21.93
GRANJA_LONGITUDE=-50.51
AMBIENTE=local
# Simulador (perfil demo): uma ronda a cada 5 minutos
INTERVALO_SEGUNDOS=300
LOTE_CODIGO=L-DEMO

# Portas publicadas pelo proxy. Na VM: 80 e 443.
HTTP_PORT=80
HTTPS_PORT=443
